# Скопируйте в .env и заполните: cp .env.example .env
# .env в .gitignore — секреты в репозиторий не попадают.

# --- Приложение ---
NODE_ENV=development
PORT=3000
# Источник истины для подключения к БД (валидируется zod-схемой в src/utils/env/env.schema.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# минимум 16 символов
JWT_SECRET=change-me-min-16-chars

# --- docker-compose (postgres) ---
# Значения должны совпадать с DATABASE_URL выше
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app
DATABASE_PORT=5432

# --- MinIO ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Storage (S3-совместимый клиент) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=app

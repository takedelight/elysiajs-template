    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@typescript-eslint/utils": "^8.71.0",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}

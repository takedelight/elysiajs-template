{
  "name": "elysia-template",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
